  "name": "GeoNet",
  "description": {
    "en": "New Zealand volcanic alert levels and felt earthquakes near your house, from GeoNet",
    "fr": "Niveaux d'alerte des volcans de Nouvelle-Zélande et séismes ressentis près de chez vous (GeoNet)",
    "de": "Vulkan-Warnstufen Neuseelands und spürbare Erdbeben in der Nähe deines Hauses, von GeoNet",
    "es": "Niveles de alerta volcánica de Nueva Zelanda y terremotos sentidos cerca de su casa (GeoNet)"
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-geonet:1.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-geonet/main/cover.png",
  "categories": ["environment", "security"],
  "transports": ["cloud"],
  "countries": ["NZ"],
  "location": true,
